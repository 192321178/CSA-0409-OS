#include <stdio.h>
#define MAX 100
int main(){
    int bitmap[MAX], n, size, i, count = 0, block;
    printf("Enter total disk blocks: ");
    scanf("%d", &n);
    printf("Enter bitmap (0-Free, 1-Allocated):\n");
    for (i = 0; i < n; i++)
        scanf("%d", &bitmap[i]);
    printf("Enter number of blocks to allocate: ");
    scanf("%d", &size);
    /* Allocation */
    for (i = 0; i < n && count < size; i++){
        if (bitmap[i] == 0){
            bitmap[i] = 1;
            count++;
        }
    }
    if (count == size)
        printf("Allocation successful\n");
    else
        printf("Not enough free space\n");
    printf("Updated bitmap: ");
    for (i = 0; i < n; i++)
        printf("%d ", bitmap[i]);
    /* Deallocation */
    printf("\nEnter block number to deallocate: ");
    scanf("%d", &block);
    if (block >= 0 && block < n && bitmap[block] == 1){
        bitmap[block] = 0;
        printf("Block %d deallocated\n", block);
    }else
        printf("Invalid block\n");
    printf("Final bitmap: ");
    for (i = 0; i < n; i++)
        printf("%d ", bitmap[i]);
    return 0;
}

