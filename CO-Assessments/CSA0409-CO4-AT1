#include <stdio.h>
#define MAX 100
int main()
{
    int disk[MAX] = {0};
    int n, size, choice, i, j, count;
    printf("Enter total disk blocks: ");
    scanf("%d", &n);
    printf("Enter file size: ");
    scanf("%d", &size);
    printf("1. Contiguous\n2. Linked\n3. Indexed\n");
    printf("Enter choice: ");
    scanf("%d", &choice);
    if (choice == 1){
        for (i = 0; i <= n - size; i++){
            count = 0;
            for (j = i; j < i + size; j++){
                if (disk[j] == 0)
                    count++;
            }
            if (count == size){
                printf("Allocated blocks: ");
                for (j = i; j < i + size; j++){
                    disk[j] = 1;
                    printf("%d ", j);
                }
                return 0;
            }
        }
        printf("Allocation failed: Fragmentation\n");
    }else if (choice == 2){
        printf("Allocated blocks: ");
        for (i = 0; i < size; i++){
            disk[i] = 1;
            printf("%d ", i);
        }
    }
    else if (choice == 3){
        printf("Index block: 0\n");
        printf("Allocated blocks: ");
        for (i = 1; i <= size; i++){
            disk[i] = 1;
            printf("%d ", i);
        }
    }else
        printf("Invalid choice");
    return 0;
}

