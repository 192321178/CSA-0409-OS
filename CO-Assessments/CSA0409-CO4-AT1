#include <stdio.h>
#include <stdlib.h>
int main(){
    int block[100], used[100]={0};
    int n, size, choice, schedule;
    int head, i, j, seek=0, count=0;
    printf("Enter disk blocks and file size: ");
    scanf("%d%d",&n,&size);
    printf("1.Contiguous 2.Indexed: ");
    scanf("%d",&choice);
    /* Allocation */
    if(choice==1){
        for(i=0;i<size;i++)
            block[i]=i;

        count=size;
    }
    else{
        for(i=0;i<size;i++)
            block[i]=i;

        count=size;
    }
    printf("Allocated Blocks: ");
    for(i=0;i<count;i++)
        printf("%d ",block[i]);
    printf("\nEnter head: ");
    scanf("%d",&head);
    printf("1.FCFS 2.SSTF: ");
    scanf("%d",&schedule);
    printf("Sequence: %d ",head);
    if(schedule==1){
        for(i=0;i<count;i++){
            seek+=abs(block[i]-head);
            head=block[i];
            printf("-> %d ",head);
        }
    }else{
        for(i=0;i<count;i++){
            int min=9999,pos;
            for(j=0;j<count;j++)
                if(!used[j] && abs(block[j]-head)<min){
                    min=abs(block[j]-head);
                    pos=j;
                }
            used[pos]=1;
            seek+=min;
            head=block[pos];
            printf("-> %d ",head);
        }
    }
    printf("\nTotal Seek Time = %d",seek);
    return 0;
}

