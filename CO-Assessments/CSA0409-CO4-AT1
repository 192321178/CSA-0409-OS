#include <stdio.h>
#include <stdlib.h>
int main(){
    int a[20], n, head, disk, i, j, pos=0;
    int cscan=0, look=0, x;
    printf("Enter n: ");
    scanf("%d",&n);
    for(i=0;i<n;i++)
        scanf("%d",&a[i]);
    printf("Enter head and disk size: ");
    scanf("%d%d",&head,&disk);
    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(a[i]>a[j]){
                int t=a[i];
                a[i]=a[j];
                a[j]=t;
            }
    while(pos<n && a[pos]<head)
        pos++;
    /* C-SCAN */
    x=head;
    printf("\nC-SCAN: %d ",x);
    for(i=pos;i<n;i++)
    {
        cscan+=abs(a[i]-x);
        x=a[i];
        printf("-> %d ",x);
    }
    cscan+=disk-1-x;
    x=0;
    cscan+=disk-1;
    for(i=0;i<pos;i++){
        cscan+=abs(a[i]-x);
        x=a[i];
        printf("-> %d ",x);
    }
    /* LOOK */
    x=head;
    printf("\nLOOK: %d ",x);
    for(i=pos;i<n;i++)
    {
        look+=abs(a[i]-x);
        x=a[i];
        printf("-> %d ",x);
    }
    for(i=pos-1;i>=0;i--){
        look+=abs(a[i]-x);
        x=a[i];
        printf("-> %d ",x);
    }
    printf("\nC-SCAN = %d",cscan);
    printf("\nLOOK = %d",look);
    if(cscan<look)
        printf("\nBest: C-SCAN");
    else
        printf("\nBest: LOOK");
    return 0;
}

