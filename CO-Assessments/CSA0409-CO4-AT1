#include <stdio.h>
#include <stdlib.h>
int main(){
    int a[20], used[20]={0}, n, head, disk;
    int i, j, x, min, pos;
    int fcfs=0, sstf=0, scan=0;
    printf("Enter n: ");
    scanf("%d",&n);
    for(i=0;i<n;i++)
        scanf("%d",&a[i]);
    printf("Enter head and disk size: ");
    scanf("%d%d",&head,&disk);
    /* FCFS */
    x=head;
    printf("\nFCFS: %d ",x);
    for(i=0;i<n;i++){
        fcfs+=abs(a[i]-x);
        x=a[i];
        printf("-> %d ",x);
    }
    /* SSTF */
    x=head;
    printf("\nSSTF: %d ",x);
    for(i=0;i<n;i++){
        min=9999; pos=-1;
        for(j=0;j<n;j++)
            if(!used[j] && abs(a[j]-x)<min){
                min=abs(a[j]-x);
                pos=j;
            }
        used[pos]=1;
        sstf+=min;
        x=a[pos];
        printf("-> %d ",x);
    }
    /* SCAN */
    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(a[i]>a[j]){
                int t=a[i];
                a[i]=a[j];
                a[j]=t;
            }
    x=head;
    printf("\nSCAN: %d ",x);
    for(i=0;i<n;i++)
        if(a[i]>=head){
            scan+=abs(a[i]-x);
            x=a[i];
            printf("-> %d ",x);
        }
    scan+=abs(disk-1-x);
    x=disk-1;
    for(i=n-1;i>=0;i--)
        if(a[i]<head){
            scan+=abs(a[i]-x);
            x=a[i];
            printf("-> %d ",x);
        }
    printf("\nFCFS = %d",fcfs);
    printf("\nSSTF = %d",sstf);
    printf("\nSCAN = %d",scan);
    if(fcfs<=sstf && fcfs<=scan)
        printf("\nBest: FCFS");
    else if(sstf<=scan)
        printf("\nBest: SSTF");
    else
        printf("\nBest: SCAN");
    return 0;
}

